/_site/
/.quarto/
**/*.quarto_ipynb

# Generated by _scripts/pre-render.sh, removed by _scripts/post-render.sh:
# changelog.qmd from CHANGELOG.md, _variables.yml from the extension manifest.
/changelog.qmd
/_variables.yml

# Cached by _scripts/pre-render.sh from GitHub's own preview card for this
# repository, and kept between renders. See assets/social/README.md.
/assets/social/og-image.png

# The extension this repository publishes, copied from the root by
# _scripts/sync-extension.sh under a `local` owner. Everything else under
# _extensions/ is a committed dependency. See _extensions/README.md.
/_extensions/local/

# The repository root ignores *.html, to keep a rendered example.qmd out of the
# commit, and a pattern with no slash in it matches at every depth: it also
# swallows the six partials atelier ships under _extensions/, which carry the
# skip link and the accessibility scripts. Nothing reports it. The files stay on
# disk, so a local render looks right, while CI clones only what is tracked and
# publishes a site without them.
# This re-includes them. It works because *.html matches files rather than
# directories, so no parent of theirs is excluded; Git will not re-include
# anything inside a directory that is.
!/_extensions/**/*.html
